// ─────────────────────── FILE & MEDIA ENGINE (PHASE 10, ED-106..118) ───────────────────────
// General-purpose file/media engine. Owns storage, versioning, derived
// variants, malware scan lifecycle and retention. Consumers (MedicalImage,
// Product, future docs) reference it via *_fileId bridges.
// SQLite: enums as String, validated in src/server/infrastructure/media/config.ts

model StoredFile {
  id             String    @id @default(cuid())
  ownerId        String
  category       String // MEDICAL_IMAGE | PRODUCT_IMAGE | RECEIPT | DELIVERY_PROOF | AVATAR | DOCUMENT
  type           String // TONGUE | FACE | RECEIPT | DELIVERY | PRODUCT | AVATAR | DOCUMENT
  accessClass    String    @default("PRIVATE") // PUBLIC | PRIVATE | TEMPORARY
  lifecycleState String    @default("ACTIVE") // ACTIVE | ARCHIVED | DELETED | PURGED
  status         String    @default("PENDING") // PENDING | PROCESSING | READY | REJECTED | INFECTED | FAILED
  caseId         String? // optional domain linkage (medical cases)
  currentVersion Int       @default(1)
  expiresAt      DateTime? // TEMPORARY: purge deadline
  deletedAt      DateTime? // soft delete → trash retention → purge
  purgedAt       DateTime?
  rejectionReason String?
  fileName       String? // denormalized from current version (fast list views)
  mime           String
  sizeBytes      Int
  sha256         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  versions      StoredFileVersion[]
  medicalImages MedicalImage[]
  productImages Product[]         @relation("ProductImageFile")

  @@index([ownerId, createdAt])
  @@index([lifecycleState, expiresAt])
  @@index([status])
}

model StoredFileVersion {
  id         String   @id @default(cuid())
  fileId     String
  version    Int
  fileName   String?
  mime       String
  sizeBytes  Int
  sha256     String
  storageKey String // relative key inside the storage driver (zone-prefixed)
  width      Int?
  height     Int?
  metadata   String? // JSON: quality report, scan report, processing stats
  scanStatus String   @default("PENDING") // PENDING | CLEAN | INFECTED | SUSPECT
  scanEngine String?
  createdAt  DateTime @default(now())

  file     StoredFile          @relation(fields: [fileId], references: [id])
  variants StoredFileVariant[]

  @@unique([fileId, version])
  @@index([fileId])
}

model StoredFileVariant {
  id         String   @id @default(cuid())
  versionId  String
  variant    String // original | compressed | ai | thumb
  storageKey String
  mime       String
  sizeBytes  Int
  width      Int?
  height     Int?
  ready      Boolean  @default(false) // filled by the async worker
  createdAt  DateTime @default(now())

  version StoredFileVersion @relation(fields: [versionId], references: [id])

  @@unique([versionId, variant])
  @@index([versionId])
}

// ── PHASE 12: Workflow Governance State ──────────────────────────────────
// Tracks WHEN each workflow instance entered its current status so the
// governance runtime can evaluate SLA/timeout policies (REMIND / ESCALATE /
// AUTO_TRANSITION), detect drift (status changed outside the engine) and
// backfill pre-PHASE-12 rows. The engine upserts this row atomically inside
// every transition transaction — it is a projection, never a second source
// of truth: the entity row's status column remains canonical.
model WorkflowState {
  id              String    @id @default(cuid())
  entityType      String // CASE | PRESCRIPTION | ORDER | PAYMENT | SHIPMENT | TICKET | FOLLOWUP | AI_REVIEW | DELETION_REQUEST | MEDICAL_IMAGE | INVOICE
  entityId        String
  status          String
  enteredAt       DateTime  @default(now())
  lastRemindedAt  DateTime?
  reminderCount   Int       @default(0)
  escalatedAt     DateTime?
  lastDriftSyncAt DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, status, enteredAt])
}

// ── PHASE 13 · External Integration Architecture ───────────────────────────
// ED-135: one audit/telemetry row per EXTERNAL call (attempt-level detail on
// the final attempt; retries counted). Requests/responses are stored
// REDACTED — secrets masked by the integration core before persistence.
// Idempotency: unique(provider, operation, idempotencyKey) lets the
// resilience layer replay a cached SUCCESS instead of re-charging a payment
// or re-sending an SMS (BR-INT-03).
model IntegrationCallLog {
  id              String    @id @default(cuid())
  kind            String // PAYMENT | SMS | EMAIL | MAPS | AI | STORAGE | SHIPPING | CRM | ANALYTICS
  provider        String // zarinpal | kavenegar | nominatim | http-ai | local | mock-*
  operation       String // e.g. payment.request, payment.verify, sms.send
  idempotencyKey  String?
  status          String // SUCCESS | FAILED | REPLAYED | SKIPPED_CIRCUIT
  attempts        Int       @default(1)
  latencyMs       Int?
  httpStatus      Int?
  errorCode       String? // TIMEOUT | NETWORK | RATE_LIMIT | AUTH | PROVIDER | CIRCUIT_OPEN | VALIDATION
  errorMessage    String?
  requestRedacted String? // JSON, secrets masked (ED-137)
  responseRedacted String? // JSON, secrets masked
  relatedType     String? // PAYMENT | NOTIFICATION | SHIPMENT | CASE ...
  relatedId       String?
  createdAt       DateTime  @default(now())

  @@unique([provider, operation, idempotencyKey])
  @@index([kind, createdAt])
  @@index([kind, provider, status])
  @@index([createdAt])
}

// ── PHASE 15: Logging, Monitoring & Observability (ED-171) ───────────────
// Append-only operational tables with HARD purge retention (they are not
// medical/business records — soft-delete semantics do not apply; ED-172):
//   ServiceLog  — searchable structured logs (warn/error + opt-in info),
//                 fields already REDACTED before persistence (ED-166)
//   MetricPoint — periodic metric snapshots (ring in RAM + 7d durable)
//   AlertEvent  — alert lifecycle (OPEN→firing→RESOLVED) with dedup/cooldown
model ServiceLog {
  id         String   @id @default(uuid())
  t          DateTime @default(now())
  lvl        String // debug | info | warn | error
  svc        String
  msg        String
  route      String?
  method     String?
  status     Int?
  reqId      String?
  corrId     String?
  traceId    String?
  actorId    String?
  actorRole  String?
  ipHash     String? // sha256(ip)[:12] — IP is personal data (ED-173)
  fields     String? // JSON — redacted BEFORE persist (never raw PII)

  @@index([t])
  @@index([lvl, t])
  @@index([svc, t])
  @@index([reqId])
  @@index([corrId, t])
}

model MetricPoint {
  id   String   @id @default(uuid())
  at   DateTime @default(now())
  data String // JSON snapshot of the metric registry (bounded keyset)

  @@index([at])
}

model AlertEvent {
  id             String    @id @default(uuid())
  key            String    @unique // rule key (e.g. db_unavailable)
  severity       String // WARN | CRITICAL
  status         String // OPEN | RESOLVED
  msgFa          String
  msgEn          String
  payload        String? // JSON — numbers/keys only, no PII (ED-173)
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  resolvedAt     DateTime?
  fireCount      Int       @default(1)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, lastSeenAt])
  @@index([severity, status])
}

// ── PHASE 17: Reliability Engineering (ED-190/191) ─────────────────────────
// DurableJob — the job queue was in-memory only: a process crash lost every
// pending job (AI analyses, notifications, exports). Jobs are now rows:
// PENDING → RUNNING (claimed) → DONE | back-to-PENDING (retry) | DEAD (DLQ).
// ownerPid is a claim optimization: a worker only takes its own or unowned
// jobs, so the dev server and the test runner never steal each other's rows;
// crash recovery nulls stale owners (runJobRecovery, 5-minute cadence).
// Hard purge applies (operational data, not medical records — ED-172).
model DurableJob {
  id          String    @id // job_<base36ts>_<seq> — stable public contract
  type        String
  payload     String // JSON
  status      String // PENDING | RUNNING | DONE | DEAD
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  backoffMs   Int       @default(2000)
  nextRunAt   DateTime  @default(now())
  claimedAt   DateTime?
  ownerPid    Int?
  lastError   String? // 500-char cap applied at write
  corrId      String?
  traceId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  @@index([status, nextRunAt])
  @@index([type, status])
  @@index([status, updatedAt])
}

// IdempotencyRecord — duplicate-request protection (ED-191) for
// mutation-critical routes (checkout, payments, case creation). Key = client
// Idempotency-Key header, or deterministically derived (user+route+body
// canonical hash) so a double-click with no header is still deduped.
//   RUNNING → concurrent identical request → 409
//   DONE    → replay stored response (≤32KB) + Idempotency-Replayed: true
//   FAILED  → row dropped, retry executes for real
// Hard purge at expiresAt (24h) — operational data (ED-172).
model IdempotencyRecord {
  id              String   @id @default(uuid())
  key             String // header value or derived sha256 (≤64 chars)
  route           String // 'POST /api/v1/orders/checkout'
  userId          String // owner scope
  status          String // RUNNING | DONE | FAILED
  responseStatus  Int?
  responseBody    String? // JSON ≤32KB — null disables replay (oversized)
  errorCode       String?
  requestId       String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@unique([userId, route, key])
  @@index([expiresAt])
}
