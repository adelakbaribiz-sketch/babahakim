model FollowUp {
  id          String    @id @default(cuid())
  caseId      String
  patientId   String
  dueDate     DateTime
  status      String    @default("PENDING") // PENDING | DUE | COMPLETED | OVERDUE | CANCELLED
  note        String?
  resultNote  String?
  completedById String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  case        MedicalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  patient     User        @relation("FollowUpPatient", fields: [patientId], references: [id])
  completedBy User?       @relation("FollowUpCompleter", fields: [completedById], references: [id])
