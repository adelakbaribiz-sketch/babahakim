# ═══════════════════════════════════════════════════════════════════════════
# BabaHakim — production environment TEMPLATE (copy to .env.production)
# NEVER commit .env.production. Generate secrets with: bash scripts/gen-secrets.sh
# ═══════════════════════════════════════════════════════════════════════════

# ── required secrets (the app refuses to start in production without them) ──
JWT_SECRET=
# 32-byte base64. Encrypts national IDs + derives the national-ID login index.
# Set it ONCE before the first real registration and never change it casually.
FIELD_ENC_KEY=
AI_DATASET_HASH_SALT=

# ── public origin (used for CORS, payment callbacks, links in SMS) ──────────
BH_BASE=https://your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example
BH_LOG_LEVEL=info

# ── first administrator (used ONLY by the one-shot `bootstrap` service) ────
# docker compose -f docker-compose.prod.yml --env-file .env.production --profile tools run --rm bootstrap
# Remove BH_ADMIN_PASSWORD from this file after the first run.
BH_ADMIN_PHONE=
BH_ADMIN_PASSWORD=
BH_ADMIN_FIRST_NAME=
BH_ADMIN_LAST_NAME=

# ── release tag (git sha) — required by docker-compose.prod.yml ────────────
BH_VERSION=

# ── external services (empty = disabled / mock; nothing is faked as sent) ──
SMS_PROVIDER_KEY=
ZARINPAL_MERCHANT_ID=
ZARINPAL_ENV=production
ZARINPAL_CALLBACK_BASE=https://your-domain.example
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
MEDIA_CLAMAV_HOST=
MEDIA_CLAMAV_PORT=
MEDIA_STORAGE_DRIVER=local
MEDIA_BACKUP_RETENTION_DAYS=7
