# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# .env.example is the committed template (spec §51); real env files stay ignored
.env*
!.env.example
!.env.production.example
!.env.test-server.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
/test
prompt

server.log
# Skills directory
/skills/

# Database (PHASE 04 — PostgreSQL/Alembic)
database/.venv/
database/pgdata/
database/.pgurl
database/.env
**/__pycache__/
*.pyc
.pytest_cache/
database/.pgsrc/

# PHASE 10 — media engine artifacts
/backups/
/tool-results/

# PHASE 10: storage is runtime data (zones: inbox/files/quarantine/trash)
/storage/

# PHASE 19 · runtime state is NOT source (deploy.sh preflight demands a clean tree)
# the seeded dev DB is rebuilt via: bun run db:push && bun run db:seed
db/*.db
db/*.db-shm
db/*.db-wal
prisma/dev.db
# release directories + current symlink (server-side deploy artifacts)
releases/
current
# media storage = runtime state (volumes own it; .dockerignore agrees)
storage/
backups/
dist/
storage.pre-restore.*/
# PHASE 20: DB pre-restore safety copies are runtime state too (2b7c117 —
# one was accidentally committed by a phase-19 drill; class locked)
db/*.pre-restore.*

# PHASE 20 · audit-gate JSON reports are RUNTIME OUTPUT, not source
# (backend/media/ui/frontend audit gates rewrite them on every run — a
# tracked report dirtied the tree and made deploy.sh preflight refuse,
# the exact state/source class PHASE 19 sealed. perf baseline/after JSONs
# stay tracked: they are committed measurement evidence (PERF9).)
scripts/backend-audit.json
scripts/media-audit.json
scripts/ui-audit-report.json
scripts/frontend-audit-report.json
