# ═══════════════════════════════════════════════════════════════════════════
# BabaHakim (باباحکیم) — Environment Variables Template (PHASE 19 · spec §51)
# ═══════════════════════════════════════════════════════════════════════════
# Copy to `.env` (development), `.env.test`, `.env.staging`, `.env.production`
# NEVER commit real secrets (charter rule 6 · ED-59 · BR-SEC-03).
# Generate strong secrets:  bash scripts/gen-secrets.sh
#
# ── Environment matrix ──────────────────────────────────────────────────────
# | var           | dev        | test         | staging         | production   |
# |---------------|------------|--------------|-----------------|--------------|
# | NODE_ENV      | development| test         | production      | production    |
# | DATABASE_URL  | file:./db/custom.db (seeded) | file:./db/custom.db | file:/data/bh.db (copy of prod schema, FAKE data) | file:/data/bh.db (volume) |
# | JWT_SECRET    | derived (loud warn) | derived | strong random | strong random ≥32 chars — REQUIRED (boot fails without it) |
# | FIELD_ENC_KEY | derived    | derived      | strong base64   | strong base64 32B — REQUIRED |
# | BH_CHAOS      | unset      | 1            | unset (drill-only) | unset (route 404-invisible) |
# | integrations  | mock       | mock         | mock (or sandbox)| LIVE keys via secret manager |
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (REQUIRED in production — process refuses to start without them) ──
# Auth token signing (access 12h / rotating refresh 30d). ≥32 chars in production.
#   openssl rand -hex 32
JWT_SECRET=
# Field-level encryption key (PII: national code, card numbers). 32 bytes base64.
#   openssl rand -base64 32
FIELD_ENC_KEY=

# ── Database (SQLite via Prisma — ADR-0004; Postgres is the growth path) ───
# dev:      file:./db/custom.db
# docker:   file:/data/bh.db  (named volume, WAL + busy_timeout applied at boot)
DATABASE_URL=file:./db/custom.db

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOSTNAME=0.0.0.0
# Comma-separated allowed CORS origins (empty = same-origin only)
CORS_ALLOWED_ORIGINS=
# Public base URL (links in SMS/notifications; e.g. https://babahakim.example)
BH_BASE=

# ── Observability / control switches (safe defaults) ───────────────────────
# Log level for the structured logger: debug | info | warn | error
BH_LOG_LEVEL=info
# Verbose DB query logging (never enable in production)
BH_DB_LOG=
# Storage root for media variants (volume in docker: /data/storage)
BH_STORAGE_PATH=
# Chaos console arming — TEST/DRILL ONLY (env gate + ADMIN 404-invisible + TTL)
BH_CHAOS=

# ── Security scanning / media pipeline ──────────────────────────────────────
# ClamAV virus scan host/port for uploaded medical images (empty = scan off)
MEDIA_CLAMAV_HOST=
MEDIA_CLAMAV_PORT=
# Storage driver: local (implemented) — s3/MinIO reserved (ADR-0006)
MEDIA_STORAGE_DRIVER=local
# Days to keep media backups (scripts/backup.sh)
MEDIA_BACKUP_RETENTION_DAYS=7

# ── Reporting / AI budget tuning (safe defaults, bounded server-side) ───────
# Max rows for a synchronous report export before it becomes an async job
REPORT_SYNC_MAX_ROWS=2000
# Monthly AI inference budget (units) for the budget guard
AI_MONTHLY_BUDGET_UNITS=
# Salt for dataset-row hashing (AI learning dataset dedup)
AI_DATASET_HASH_SALT=

# ── CDN seam (PHASE 16 ED-185) ──────────────────────────────────────────────
# Static chunk CDN origin (empty = same node). When set, CSP must list it too.
NEXT_PUBLIC_CDN_BASE=

# ── External integrations (PHASE 13 · CREDENTIAL_SPECS) ─────────────────────
# Mode is fail-safe: LIVE only when ALL credentials for a kind are present;
# otherwise the adapter runs in MOCK and the admin console reports presence
# (booleans only — values never leave the server).

# Payment — Zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_ENV=sandbox
ZARINPAL_CALLBACK_BASE=

# SMS — Kavenegar
SMS_PROVIDER_KEY=

# Email / mailer
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# AI inference service (empty = TongueModelV1 in-process engine)
AI_SERVICE_URL=
AI_SERVICE_KEY=

# Courier / shipping
SHIPPING_API_URL=
SHIPPING_API_KEY=

# CRM sync
CRM_API_URL=
CRM_API_KEY=

# Analytics ingestion
ANALYTICS_ENDPOINT=
ANALYTICS_API_KEY=

# Object storage (reserved — S3/MinIO driver seam, ADR-0006)
STORAGE_ENDPOINT=
STORAGE_KEY=
STORAGE_SECRET=
